{
  "manifest_version": 3,
  "name": "PESUmate",
  "version": "1.1.0",
  "description": "Download all slides from PESU Academy — merge PDFs, zip PPTX, one click.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://www.pesuacademy.com/*",
    "https://files.pesuacademy.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "cors_rules",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["https://www.pesuacademy.com/Academy/*"],
      "js": ["lib/pdf-lib.min.js", "lib/jszip.min.js", "content.js"],
      "css": ["panel.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["lib/*"],
      "matches": ["https://www.pesuacademy.com/*"]
    }
  ]
}
